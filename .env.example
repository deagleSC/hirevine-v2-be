# =============================================================================
# Hirevine API — environment variables
# =============================================================================
# Copy this file to `.env` and adjust values. The app loads `.env` automatically
# (see `src/config/env.ts`). Never commit a real `.env` file.
#
# Quick start (local dev): only MONGODB_URI might need changing if Mongo isn’t
# on localhost. JWT_SECRET can stay unset in development (insecure default).
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# NODE_ENV affects cookie security defaults and whether JWT_SECRET is mandatory.
# Typical values: development | production | test
# Default if unset: development
NODE_ENV=

# HTTP port for `npm run dev` / `npm start`.
# Default if unset or invalid: 8000
PORT=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Full MongoDB connection string (Atlas, Docker, or local mongod).
# Default if unset: mongodb://127.0.0.1:27017/hirevine
#
# Examples:
#   mongodb://127.0.0.1:27017/hirevine
#   mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/hirevine?retryWrites=true&w=majority
MONGODB_URI=

# -----------------------------------------------------------------------------
# CORS (frontend → API with cookies)
# -----------------------------------------------------------------------------
# Browsers only send cookies on cross-origin requests if the API’s CORS policy
# lists your frontend origin exactly. Use a comma-separated list with no spaces
# after commas, or one origin per conceptual “app”.
#
# Default if unset: all origins allowed (fine for local tooling; tighten for prod).
#
# Examples (production):
#   CORS_ORIGIN=https://app.yourdomain.com
#   CORS_ORIGIN=https://preview-123.vercel.app,https://app.yourdomain.com
CORS_ORIGIN=

# -----------------------------------------------------------------------------
# Auth: JWT session (HTTP-only cookie)
# -----------------------------------------------------------------------------
# **Required in production.** Used to sign and verify session JWTs.
# In development, if unset, a fixed dev secret is used (not safe for real data).
# Generate a strong random value, e.g. `openssl rand -base64 32`
JWT_SECRET=

# How long the session JWT remains valid, in seconds.
# Default if unset or invalid: 604800 (7 days)
JWT_EXPIRES_SEC=

# Name of the HTTP-only cookie that stores the JWT (browser sends it automatically
# on credentialed requests to this API).
# Default if unset: hirevine_session
AUTH_COOKIE_NAME=

# When NODE_ENV=production, session cookies use Secure=true by default (HTTPS only).
# Browsers will ignore Set-Cookie on plain http:// (e.g. localhost). For local prod-like
# runs over HTTP, set to false (never do this on a public deployment).
# Allowed: false | (unset = secure cookies in production)
AUTH_COOKIE_SECURE=

# SameSite policy for the session cookie. Affects cross-site vs same-site behavior.
# Allowed values: lax | strict | none
# - Development default (when unset): lax
# - Production default (when unset): none (typical for SPA on another domain than API;
#   requires HTTPS / Secure cookies)
# Set explicitly if your frontend and API share one origin and you prefer stricter behavior.
AUTH_COOKIE_SAMESITE=

# -----------------------------------------------------------------------------
# Resume upload size (optional)
# -----------------------------------------------------------------------------
# Max multipart file size in bytes. Default 4194304 (4 MiB) so uploads work on Vercel serverless
# (~4.5 MiB request cap). Self-hosted / other hosts may set e.g. 5242880 (5 MiB).
# RESUME_UPLOAD_MAX_BYTES=

# -----------------------------------------------------------------------------
# Vercel Blob (candidate resume uploads)
# -----------------------------------------------------------------------------
# Required for POST /api/resumes/upload in production. Create a store in the Vercel dashboard
# and copy the read/write token. Apply (POST /api/jobs/:jobId/apply) accepts only HTTPS URLs
# pointing at this Blob store (*.public.blob.vercel-storage.com) unless you set ALLOW_ANY_RESUME_URL.
BLOB_READ_WRITE_TOKEN=

# Optional: if you serve blobs behind a custom hostname, set it here (hostname only, no scheme).
BLOB_PUBLIC_HOST=

# Development only: allow any https resumeUrl on apply (e.g. E2E script with example.com).
# Never enable in production.
ALLOW_ANY_RESUME_URL=

# -----------------------------------------------------------------------------
# OpenRouter (AI — pipeline generation + Inngest resume & final report)
# -----------------------------------------------------------------------------
# When set, Inngest Node 1 (resume screen) and Node 3 (hiring summary) call this model.
# When unset, those steps use deterministic stubs (still advances the pipeline).
# Required for POST /api/jobs/:jobId/generate-pipeline in production.
OPENROUTER_API_KEY=

# Model id (default openai/gpt-4o-mini). Prefer models that support JSON / tool output;
# the app sends structured-output requests with strict JSON schema disabled for OpenRouter compatibility.
OPENROUTER_MODEL=

# API base URL (default https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# -----------------------------------------------------------------------------
# Inngest (async workflows — application pipeline)
# -----------------------------------------------------------------------------
# Production (Inngest Cloud + deployed API):
# - INNGEST_SIGNING_KEY — required so `/api/inngest` can register and receive invocations.
# - INNGEST_EVENT_KEY — required so the API can `inngest.send(...)` (apply → Node 1, quiz → Node 3).
# Copy both from Inngest → App → Manage → Signing Key / Event Key. In the dashboard, set the app’s
# “Serve” URL to `https://<your-api-host>/api/inngest` and deploy after env vars are set.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Local: with `npm run inngest:dev`, the app uses dev mode automatically when NODE_ENV is not
# production and INNGEST_SIGNING_KEY is unset. Optionally set explicitly:
#   INNGEST_DEV=1
# Or point sends at the dev server:
#   INNGEST_DEV=http://127.0.0.1:8288
INNGEST_DEV=

# -----------------------------------------------------------------------------
# E2E script only (`npx tsx scripts/verify-jobs-apply-inngest-once.ts`)
# -----------------------------------------------------------------------------
# RECRUITER_PASSWORD= / CANDIDATE_PASSWORD= — test accounts (script loads .env via dotenv).
# E2E_CLEAR_PASS_THRESHOLD=false — keep generate-pipeline passThreshold (real AI rejections).
# E2E_LOG_PIPELINE_OUTPUT=false — skip printing full Node 1–3 reasoning/payload.
# E2E_RESUME_PATH= — override default PDF path.
